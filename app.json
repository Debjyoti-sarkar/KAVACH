{
  "expo": {
    "name": "NEXAVAULT",
    "slug": "nexavault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexavault",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexavault.app",
      "infoPlist": {
        "NSCameraUsageDescription": "NEXAVAULT needs camera access to scan QR codes for payments",
        "NSFaceIDUsageDescription": "NEXAVAULT uses Face ID for secure authentication",
        "NSMicrophoneUsageDescription": "NEXAVAULT needs microphone access for voice commands"
      }
    },
    "android": {
      "package": "com.nexavault.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F1E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F1E8",
          "dark": {
            "backgroundColor": "#1A1A1A"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NEXAVAULT to access your camera for QR code scanning"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow NEXAVAULT to use Face ID for secure authentication"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}

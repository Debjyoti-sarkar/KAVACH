{
  "expo": {
    "name": "NEXAVAULT",
    "slug": "nexavault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexavault",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexavault.app",
      "infoPlist": {
        "NSCameraUsageDescription": "NEXAVAULT needs camera access to scan QR codes for payments",
        "NSFaceIDUsageDescription": "NEXAVAULT uses Face ID for secure authentication",
        "NSMicrophoneUsageDescription": "NEXAVAULT needs microphone access for voice commands"
      }
    },

    "android": {
      "package": "com.nexavault.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F1E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_PHONE_STATE"
      ]
    },

    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F1E8",
          "dark": {
            "backgroundColor": "#1A1A1A"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NEXAVAULT to access your camera for QR code scanning"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow NEXAVAULT to use Face ID for secure authentication"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF0000",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "./plugins/withSMSReceiver"
    ],

    "experiments": {
      "reactCompiler": true
    },

    "extra": {
      "eas": {
        "projectId": "66c7b9a6-1702-4619-b50b-4b5474dcde3a"
      }
    }
  }
}
